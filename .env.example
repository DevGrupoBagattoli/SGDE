# Conexão com o banco (dev local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgde?schema=public"

# Porta do app exposta no host (dev local)
APP_PORT="3000"

# Migrations automáticas no startup do container (Dockerfile)
# true  = roda `prisma migrate deploy` antes de iniciar (padrão)
# false = não roda migrations (use se houver múltiplas réplicas)
RUN_MIGRATIONS=true

# Opcional para bootstrap em producao (docker compose --profile ops run bootstrap)
FIRST_MANAGER_NAME=""
FIRST_MANAGER_PASSWORD=""

# ── Notificações push (Web Push PWA) ────────────────────────────────────────
# Gere com: pnpm run push:generate-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato exigido pelo padrão VAPID (mailto: ou https:)
VAPID_SUBJECT="mailto:contato@bagattolitech.com.br"

# Token secreto chamado pelo agendador (Coolify Scheduled Task).
# Gere com: openssl rand -hex 32
CRON_SECRET=""

# Janela do lembrete de início, em minutos antes de inicioPrevisto (padrão: 15)
NOTIFY_UPCOMING_MINUTES="15"

# Escalonamento ao gestor: horas sem leitura até notificar o criador da demanda (padrão: 2)
NOTIFY_ESCALATION_HOURS="2"

# Re-disparo do lembrete de finalização: teto em horas após o fim previsto (padrão: 24)
NOTIFY_FINISH_MAX_HOURS="24"

# ── Canal e-mail (Brevo) — fallback quando não há push ativo ───────────────
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="SGDE"

# Fuso da empresa: exibição, agenda, relatórios, CSV e notificações.
# Lido no build (vale para tela e servidor). Padrão: America/Porto_Velho.
NEXT_PUBLIC_APP_TIMEZONE=America/Porto_Velho

# Sentry (monitoramento de erros). Vazio = desligado. Lido no build (cliente) e em runtime (servidor).
NEXT_PUBLIC_SENTRY_DSN=""
# Opcional: upload de source maps no build (token de organização com escopo org:ci).
# Só no build, nunca como NEXT_PUBLIC_*. Vazio = pula o upload.
SENTRY_AUTH_TOKEN=""
